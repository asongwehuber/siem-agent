# ============================================================================
# SIEM Agent Configuration
# ============================================================================

# Shared secret used to verify HMAC-SHA256 signatures.
# This value MUST match the SECRET_KEY configured in the Log Generator.
SECRET_KEY=your-shared-secret

# ----------------------------------------------------------------------------
# SIEM Agent Server
# ----------------------------------------------------------------------------

# Host address on which the SIEM Agent listens for incoming requests.
AGENT_HOST=0.0.0.0

# Port used by the SIEM Agent.
AGENT_PORT=6000

# ----------------------------------------------------------------------------
# Mini-SIEM Endpoints
# ----------------------------------------------------------------------------

# Endpoint used to forward validated log events.
SIEM_LOG_ENDPOINT=http://127.0.0.1:5000/submit-log

# Endpoint used to forward heartbeat messages.
SIEM_HEARTBEAT_ENDPOINT=http://127.0.0.1:5000/submit-heartbeat